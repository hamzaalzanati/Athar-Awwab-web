# ===== Vercel > Project > Settings > Environment Variables =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase > Settings > API > service_role (سرّي، لا يوضع في المتصفح أبدًا)
TELEGRAM_BOT_TOKEN=                   # نفس توكن البوت: للتحقق من هوية الأدمن وجلب الصور المصغّرة
SITE_URL=https://your-domain.com      # بلا / في النهاية (للـ sitemap ومعاينة المشاركة)

# اختياري
BOT_USERNAME=                         # بدون @ : يُظهر زر «راسلنا عبر البوت»
HERO_IMAGE_URL=                       # بديل لصورة الواجهة (https://... أو /images/x.jpg)؛ إعداد لوحة التحكم يتقدم عليه

# زناتي (اختياري: بدون مفاتيح تُجيب بالأرقام مباشرة بلا ذكاء اصطناعي)
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_HELPER=
GEMINI_API_KEY_EMERGENCY=
GEMINI_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.6-flash
