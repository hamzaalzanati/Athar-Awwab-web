<?xml version="1.0" encoding="UTF-8"?>
<!--
  عدّل "https://YOUR-DOMAIN" لدومينك الحقيقي بعد نشر الموقع على Vercel،
  ثم أضف هذا الملف على Google Search Console (Sitemaps) لتحسين ظهور
  الموقع في نتائج البحث.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://YOUR-DOMAIN/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/#channels</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/#bots</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/#social</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/#news</loc>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>https://YOUR-DOMAIN/#contact</loc>
    <changefreq>yearly</changefreq>
    <priority>0.4</priority>
  </url>
</urlset>
